{
  "name": "kinkeda",
  "version": "1.0.0",
  "private": true,
  "description": "Kinkeda — 2-player thumb-guessing game for a shared multi-touch screen",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "build:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "build:web": "npm run build:css && node scripts/copy-web.mjs",
    "dev:web": "npx serve .",
    "cap:sync": "npm run build:web && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "build:android-download": "node scripts/copy-android-download.mjs",
    "deploy:android-signup": "wrangler deploy"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "wrangler": "^4.24.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@resvg/resvg-js": "^2.6.2"
  }
}
