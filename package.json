{
  "name": "kinkeda",
  "version": "1.0.0",
  "private": true,
  "description": "Kinkeda — 2-player thumb-guessing game for a shared multi-touch screen",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build:web": "node scripts/copy-web.mjs",
    "dev:web": "npx serve .",
    "cap:sync": "npm run build:web && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "cap run android",
    "cap:run:ios": "cap run ios",
    "build:android-download": "node scripts/copy-android-download.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/splash-screen": "^7.0.5",
    "@resvg/resvg-js": "^2.6.2"
  }
}
